---
import project from '../data/generated/project.json';
import { spell } from '../lib/numbers';
import { Code } from 'astro:components';
import { CODE_THEME } from '../lib/code';

// Repository paths are written out literally; see the note in Architecture.astro.
const repoUrl = 'https://github.com/DemchaAV/graphcompose-ai-flow';

const clone = `git clone ${repoUrl}
cd graphcompose-ai-flow
npm run setup`;

const installs = [
  {
    id: 'claude-code',
    host: 'Claude Code',
    packaging: 'a plugin',
    lang: 'text',
    code: `/plugin marketplace add DemchaAV/graphcompose-ai-flow
/plugin install ${project.pluginName}@${project.marketplaceName}`,
    after:
      'Then, once: `npm run setup`. Two of the tools are TypeScript compiled into `dist/`, which is not committed, so a fresh install has no build output.',
    href: `${repoUrl}/blob/main/docs/plugin-installation.md`,
    label: 'docs/plugin-installation.md',
  },
  {
    id: 'codex',
    host: 'Codex',
    packaging: `${spell(project.workflowCount)} skills`,
    lang: 'bash',
    code: `${clone}
node adapters/codex/install.mjs`,
    after:
      'Copies the runtime to `~/.codex/graphcompose-flow/<version>/`, so the clone is not needed afterwards — move it, rename it or delete it and the skills keep working.',
    href: `${repoUrl}/blob/main/adapters/codex/README.md`,
    label: 'adapters/codex/README.md',
  },
  {
    id: 'gemini',
    host: 'Gemini CLI',
    packaging: 'an extension',
    lang: 'bash',
    code: `${clone}
node adapters/gemini/install.mjs`,
    after:
      'Gemini takes extensions rather than plugins, so this writes one to `~/.gemini/extensions/graphcompose-flow/` — commands, skill, hooks and runtime inside it. Restart, then `gemini extensions list`.',
    href: `${repoUrl}/blob/main/adapters/gemini/README.md`,
    label: 'adapters/gemini/README.md',
  },
];

// The gestures the skills fire from. No command is typed: this is the whole
// interface once the harness is installed.
const gestures = [
  {
    say: 'An invoice like the one we did before',
    does: 'the catalog of published bundles is checked first — a match is a file copy into your project, not the loop',
  },
  {
    say: 'Create this in GraphCompose',
    aside: '+ a screenshot',
    does: 'analyse → architecture → assets → code → compile → render → diff → fix the largest mismatch → repeat',
  },
  {
    say: 'Make the sidebar wider',
    does: 'a new revision under the narrowest scope that fits, gated against the right baseline',
  },
  {
    say: "What's still different?",
    does: 'a measured verdict and a ranked mismatch list, without changing anything',
  },
  {
    say: 'approve',
    does: 'DRAFT → APPROVED, the previous approved superseded, the bundle published',
  },
];

// Turns `backticks` into <code> spans. The text is escaped first: these strings
// carry shell placeholders like <version>, and handing them to set:html unescaped
// makes the browser eat them as unknown tags — which is how the Codex card
// silently advertised a path of "graphcompose-flow//".
const escape = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const inline = (text: string) =>
  text
    .split('`')
    .map((part, i) => (i % 2 ? `<code>${escape(part)}</code>` : escape(part)))
    .join('');
---
<section class="install" id="install">
  <div class="container">
    <p class="eyebrow">03 · getting it</p>
    <h2>Install it into the agent you already use.</h2>
    <p class="lede">
      There is no service to sign up for and nothing to run alongside your editor. The
      harness installs into the host as {spell(project.hosts.length)} packagings of the same
      runtime, and after that the skills fire from plain sentences.
    </p>

    <div class="cards">
      {installs.map((install) => (
        <article class="card">
          <header>
            <h3>{install.host}</h3>
            <span class="tag">{install.packaging}</span>
          </header>
          <Code code={install.code} lang={install.lang} theme={CODE_THEME} />
          <p class="after" set:html={inline(install.after)} />
          <a href={install.href}><code>{install.label}</code> →</a>
        </article>
      ))}
    </div>

    <p class="needs">
      You need Node 20+, Java 21+, Maven and ImageMagick, plus a Java project that pins
      <code>{project.library.coordinate}</code> — the version in <em>your</em> build file
      decides which skill pack the agent authors against.
      <a href={`${repoUrl}/blob/main/scripts/setup.mjs`}><code>npm run setup</code></a>
      checks the whole toolchain before it builds anything.
    </p>

    <h3 class="gestures-head">Then say what you want.</h3>
    <ul class="gestures">
      {gestures.map((gesture) => (
        <li>
          <p class="say">
            <span>“{gesture.say}”</span>
            {gesture.aside && <em>{gesture.aside}</em>}
          </p>
          <p class="does">{gesture.does}</p>
        </li>
      ))}
    </ul>

    <p class="footnote">
      Every render rewrites <code>current.pdf</code> next to the project, so one open
      window follows the whole run — you watch the layout arrive instead of hunting for
      the newest file under <code>revisions/</code>. It needs a viewer that reloads on
      change and does not hold the file open.
    </p>
  </div>
</section>

<style>
  .lede {
    max-width: 720px;
    color: var(--fg-muted);
    margin: 16px 0 48px 0;
    font-size: 1.05rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 940px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    /* A grid item defaults to min-width:auto, so the long `git clone …` line
       inside the <pre> below widens its track instead of scrolling in place,
       and the whole page ends up scrolling sideways. */
    min-width: 0;
  }
  .card header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .card h3 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
  }

  /* Shiki emits `pre.astro-code` with the theme's own background inline. The
     frame is ours, the colours are the theme's; `background` has to win over
     that inline style, hence the important. */
  .card :global(pre.astro-code) {
    margin: 0 0 14px 0;
    padding: 14px 16px;
    background: var(--bg) !important;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
  }
  /* These are the one thing on the page a visitor copies, so they wrap rather
     than scroll: a clone URL behind a scrollbar reads as a truncated command.
     The indent marks a continuation as a continuation. */
  .card :global(pre.astro-code code) {
    display: block;
    font-size: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .card :global(pre.astro-code .line) {
    display: inline-block;
    text-indent: -1.1em;
    padding-left: 1.1em;
  }

  .after {
    margin: 0 0 16px 0;
    color: var(--fg-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  .after :global(code) {
    color: var(--fg);
    font-size: 0.9em;
  }
  .card > a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    align-self: flex-start;
  }
  .card > a code {
    color: inherit;
  }

  .needs {
    margin: 28px 0 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 860px;
  }
  .needs code {
    color: var(--fg);
  }
  .needs em {
    color: var(--fg);
    font-style: normal;
  }

  .gestures-head {
    margin: 64px 0 20px 0;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .gestures {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .gestures li {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.6fr;
    gap: 16px 32px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  @media (max-width: 720px) {
    .gestures li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
  .say {
    margin: 0;
    color: var(--fg);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .say em {
    display: block;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-style: normal;
    margin-top: 2px;
  }
  .does {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footnote {
    margin-top: 40px;
    color: var(--fg-dim);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 820px;
  }
  .footnote code {
    color: var(--fg-muted);
  }
</style>
