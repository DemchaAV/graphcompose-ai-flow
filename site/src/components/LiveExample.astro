---
import runsData from '../data/runs.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Cycle = { label: string; minutes: number; output: string; cacheRead: string; requests: number };
type Run = {
  id: string;
  title: string;
  subtitle: string;
  images: { reference: string; oneRequest: string; final: string };
  autonomousRevisions: number;
  corrections: number;
  totalRevisions: number;
  minutes?: number;
  correctionSummary: string;
  note?: string;
  quote?: string;
  cycles?: Cycle[];
};

const runs = runsData.runs as Run[];
const caveat = runsData.caveat as string;
---
<section class="live" id="example">
  <div class="container">
    <p class="eyebrow">05 · two real runs</p>
    <h2>How close does one request get?</h2>
    <p class="lede">
      A first render is never right. What matters is how close one request gets,
      and what closing the rest costs. Both runs below are the reference, what
      <strong>one request</strong> produced with no further input, and the result
      after the corrections.
    </p>

    <div class="runs">
      {runs.map((run) => (
        <article class="run">
          <header class="run-head">
            <h3>{run.title}</h3>
            <p class="sub">{run.subtitle}</p>
            <p class="counts">
              <span><strong>{run.autonomousRevisions}</strong> revisions unattended</span>
              <span aria-hidden="true">·</span>
              <span><strong>{run.corrections}</strong> {run.corrections === 1 ? 'correction' : 'corrections'}</span>
              <span aria-hidden="true">·</span>
              <span><strong>{run.totalRevisions}</strong> in total</span>
              {run.minutes && (<><span aria-hidden="true">·</span><span><strong>{run.minutes}</strong> min</span></>)}
            </p>
          </header>

          <div class="triple">
            <figure>
              <figcaption>Reference</figcaption>
              <img src={`${base}/previews/${run.images.reference}`} alt={`${run.title} reference`} loading="lazy" />
            </figure>
            <figure class="highlight">
              <figcaption>After one request</figcaption>
              <img src={`${base}/previews/${run.images.oneRequest}`} alt={`${run.title} after one request`} loading="lazy" />
            </figure>
            <figure>
              <figcaption>After {run.corrections} {run.corrections === 1 ? 'correction' : 'corrections'}</figcaption>
              <img src={`${base}/previews/${run.images.final}`} alt={`${run.title} after corrections`} loading="lazy" />
            </figure>
          </div>

          <p class="says">{run.correctionSummary}</p>
          {run.quote && (<blockquote>{run.quote}</blockquote>)}
          {run.note && (<p class="note">{run.note}</p>)}

          {run.cycles && (
            <div class="cycles">
              <p class="cycles-label">measured by the harness itself</p>
              <table>
                <tbody>
                  {run.cycles.map((cycle) => (
                    <tr>
                      <th scope="row">{cycle.label}</th>
                      <td>{cycle.minutes} min</td>
                      <td>{cycle.output} output</td>
                      <td>{cycle.cacheRead} cache read</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="ratio">A correction costs roughly a tenth of the original run.</p>
            </div>
          )}
        </article>
      ))}
    </div>

    <p class="caveat">{caveat}</p>
  </div>
</section>

<style>
  .lede {
    max-width: 720px;
    color: var(--fg-muted);
    margin: 16px 0 48px 0;
    font-size: 1.05rem;
  }
  .lede strong {
    color: var(--fg);
  }

  .runs {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .run-head {
    margin-bottom: 18px;
  }
  .run-head h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  .sub {
    margin: 4px 0 0 0;
    color: var(--fg-dim);
    font-size: 0.95rem;
  }
  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
  }
  .counts strong {
    color: var(--fg);
  }

  .triple {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 880px) {
    .triple {
      grid-template-columns: 1fr;
    }
  }

  figure {
    margin: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  /* The middle column is the claim being made, so it is the one to look at. */
  figure.highlight {
    border-color: var(--accent, var(--fg-dim));
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-dim);
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }
  figure.highlight figcaption {
    color: var(--fg);
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
  }

  .says {
    margin: 20px 0 0 0;
    color: var(--fg-muted);
    max-width: 760px;
  }
  blockquote {
    margin: 12px 0 0 0;
    padding: 10px 16px;
    border-left: 2px solid var(--border);
    color: var(--fg-dim);
    font-size: 0.95rem;
  }
  .note {
    margin: 14px 0 0 0;
    color: var(--fg-dim);
    font-size: 0.92rem;
    max-width: 760px;
    line-height: 1.65;
  }

  .cycles {
    margin-top: 24px;
    padding: 20px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .cycles-label {
    margin: 0 0 12px 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .cycles table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .cycles th {
    text-align: left;
    font-weight: 400;
    color: var(--fg);
    padding: 5px 16px 5px 0;
  }
  .cycles td {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-muted);
    padding: 5px 16px 5px 0;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .cycles td {
      white-space: normal;
    }
  }
  .ratio {
    margin: 14px 0 0 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .caveat {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--fg-dim);
    font-size: 0.92rem;
    max-width: 820px;
    line-height: 1.7;
  }
</style>
