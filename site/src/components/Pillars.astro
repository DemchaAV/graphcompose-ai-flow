---
import project from '../data/generated/project.json';

// Repository paths are written out literally; see the note in Architecture.astro.
const repoUrl = 'https://github.com/DemchaAV/graphcompose-ai-flow';

const pillars = [
  {
    title: 'The gate is arithmetic',
    body: `Three gates, one per kind of change. A refactor must produce AE == 0 against its parent. A data edit may differ only in the regions it touched. A visual change is reviewed layer by layer against the reference. The metric is quoted verbatim into the verdict, never paraphrased — "looks identical" is not a gate result.`,
    href: `${repoUrl}/blob/main/config/pipeline.json`,
    linkLabel: 'config/pipeline.json',
  },
  {
    title: 'Nothing is overwritten',
    body: 'Every change opens a new revision with DRAFT, APPROVED, REJECTED, REVERTED, SUPERSEDED or FAILED. Approving supersedes rather than replaces. The failed passes stay on disk with what broke and what was tried, and a single component can be restored from any earlier revision.',
    href: `${repoUrl}/blob/main/docs/revision-model.md`,
    linkLabel: 'docs/revision-model.md',
  },
  {
    title: 'The version decides the API',
    body: `Your build file is read, the pinned line is mapped to a skill pack, and a line with no pack stops the run rather than being rounded to the nearest one. The pack's allow-list is a closed set: absent means the call does not exist. If a skill and the library disagree, the library wins.`,
    href: `${repoUrl}/blob/main/docs/versioned-skills.md`,
    linkLabel: 'docs/versioned-skills.md',
  },
  {
    title: 'The allow-list is checked against the real jar',
    body: `Five fixture projects compile, test and render against GraphCompose ${project.library.default.replace('.x', '.0')} from Maven Central in CI, each render identical to its baseline. Five fixtures are a subset of what the packs describe, and the page says so rather than calling it coverage.`,
    href: `${repoUrl}/tree/main/examples/skill-fixtures`,
    linkLabel: 'examples/skill-fixtures/',
  },
  {
    title: 'The loop is bounded',
    body: `A separate tool counts the iterations, the consecutive build failures and the repeats of the same mismatch, and answers ready / revise / blocked with an exit code. It stops at ${project.limits.maxIterations} passes, ${project.limits.maxConsecutiveBuildFailures} build failures in a row, or ${project.limits.maxSameMismatchAttempts} attempts at one mismatch. An agent going round in circles is the last thing qualified to notice it.`,
    href: `${repoUrl}/blob/main/scripts/iterate-status.mjs`,
    linkLabel: 'scripts/iterate-status.mjs',
  },
  {
    title: 'The geometry is measured, not argued about',
    body: 'The renderer writes GraphCompose’s own post-layout snapshot beside the PDF, so "this block sits too far right" is arithmetic. The diagnostics name the additive chain and the node that owns the offset rather than the one that shows it — and answer "I cannot derive this" instead of producing a number they cannot support.',
    href: `${repoUrl}/blob/main/scripts/layout.mjs`,
    linkLabel: 'scripts/layout.mjs',
  },
  {
    title: 'What earlier runs learned is kept',
    body: 'When the loop cannot tell a layout fault from a painting fault, it writes a probe — a throwaway document that renders one arrangement and measures the pixels — and settles it. The finding is recorded with the probe that re-confirms it, so the next run does not pay for it twice.',
    href: `${repoUrl}/blob/main/observations/README.md`,
    linkLabel: 'observations/README.md',
  },
  {
    title: 'Content is a JSON file, not a Java edit',
    body: 'Templates take their content through a typed spec loaded by a spec provider. Changing an email is one JSON change. If swapping the data means editing Java, the contract is broken and the review says so.',
    href: `${repoUrl}/blob/main/skills/workflows/references/authoring-rules.md`,
    linkLabel: 'authoring-rules.md',
  },
  {
    title: 'Nothing ships without a human APPROVE',
    body: 'The review skill writes a structured verdict and the loop stops there. Publishing happens only when a person approves, and the publisher refuses any revision that is not APPROVED. The agent never marks its own work ready to ship.',
    href: `${repoUrl}/blob/main/skills/workflows/approve-template/SKILL.md`,
    linkLabel: 'approve-template/SKILL.md',
  },
  {
    title: 'CI that actually compiles',
    body: 'Separate jobs run the revision manager, the visual diff, the preview renderer, the skill fixtures, the schema validation and a cross-cutting harness-contract check that fails when the routing, the schemas, the skills and the packaging stop agreeing. Node 20 + Java 21 + Maven.',
    href: `${repoUrl}/blob/main/.github/workflows/ci.yml`,
    linkLabel: '.github/workflows/ci.yml',
  },
];
---
<section class="pillars" id="why">
  <div class="container">
    <p class="eyebrow">06 · the moat</p>
    <h2>Why this isn't prompt-and-hope.</h2>
    <p class="lede">
      Most AI document tools are a prompt with a hopeful disposition. This one is closer
      to a build pipeline: the work has contracts, outputs go through tests, regressions
      get caught, and nothing ships without a human-signed APPROVE.
    </p>

    <ul class="grid">
      {pillars.map((p) => (
        <li class="card">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <a href={p.href}><code>{p.linkLabel}</code> →</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lede {
    max-width: 720px;
    color: var(--fg-muted);
    margin: 16px 0 48px 0;
    font-size: 1.05rem;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .card h3 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 10px;
    line-height: 1.35;
  }
  .card p {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }
  .card a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    align-self: flex-start;
  }
  .card a code {
    color: inherit;
  }
</style>
