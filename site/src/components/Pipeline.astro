---
import data from '../data/generated/pipeline.json';
const repoUrl = 'https://github.com/DemchaAV/graphcompose-ai-flow';
const stages = data.stages as Array<{
  id: string;
  label: string;
  kind: string;
  description: string;
  tool: string | null;
}>;
const workflows = data.workflows as Array<{
  id: string;
  skill: string;
  summary: string;
  scopes: string[];
}>;
---
<section id="pipeline" class="pipeline">
  <div class="container">
    <p class="eyebrow">02 · how it works</p>
    <h2>Four skills. One bounded loop.</h2>
    <p class="lede">
      You say what you want; a workflow skill owns the request end to end. Behind it
      the same ordered stages run — some are the model's judgement, most are a CLI,
      and the last two are gates that decide with an exit code, not an opinion.
      <em>This is the moat against prompt-and-hope.</em>
    </p>

    <ul class="workflows">
      {workflows.map((workflow) => (
        <li class="workflow">
          <a href={`${repoUrl}/blob/main/${workflow.skill}`}><code>{workflow.id}</code></a>
          <span>{workflow.summary}</span>
        </li>
      ))}
    </ul>

    <ol class="chain">
      {stages.map((stage, idx) => (
        <li class="step">
          <div class="num">
            <span class="num-badge">{String(idx + 1).padStart(2, '0')}</span>
          </div>
          <div class="card">
            <header>
              <h3>{stage.label}</h3>
              <span class={`kind kind-${stage.kind}`}>{stage.kind.toUpperCase()}</span>
            </header>
            <p class="role">{stage.description}</p>
            {stage.tool && (
              <div class="io">
                <div class="io-col">
                  <span class="io-label">runs</span>
                  <ul><li>{stage.tool}</li></ul>
                </div>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="footnote">
      Which stages a scope runs, the gate it ends on and the loop bounds are declared once in
      <a href={`${repoUrl}/blob/main/config/pipeline.json`}><code>config/pipeline.json</code></a>,
      which this list is generated from at build time. The skills that run them live in
      <a href={`${repoUrl}/blob/main/skills/workflows`}><code>skills/workflows/</code></a>.</p>
  </div>
</section>

<style>
  .lede {
    max-width: 720px;
    color: var(--fg-muted);
    margin: 16px 0 48px 0;
    font-size: 1.05rem;
  }
  .lede em {
    color: var(--fg);
    font-style: normal;
  }

  .chain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    position: relative;
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 31px;
    top: 64px;
    bottom: -18px;
    width: 2px;
    background: linear-gradient(to bottom, var(--border-strong), transparent);
  }

  .num {
    display: flex;
    justify-content: center;
    padding-top: 16px;
  }
  .num-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px 22px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .card header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .card h3 {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
  }
  .src-link code {
    color: var(--fg-dim);
    font-size: 0.78rem;
  }
  .src-link:hover code {
    color: var(--accent);
  }

  .role {
    margin: 0 0 14px 0;
    color: var(--fg-muted);
    font-size: 0.97rem;
    line-height: 1.55;
  }

  .io {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    border-top: 1px dashed var(--border);
    padding-top: 14px;
  }
  @media (max-width: 560px) {
    .io {
      grid-template-columns: 1fr;
    }
  }
  .io-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .io-col li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 3px 8px;
  }
  .io-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 8px;
  }

  .footnote {
    margin-top: 40px;
    color: var(--fg-dim);
    font-size: 0.9rem;
  }
  .footnote code {
    color: var(--fg-muted);
  }

  .workflows {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    gap: 0.5rem;
  }
  .workflows li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: baseline;
  }
  .workflows code { font-size: 0.9rem; }
  .workflows span { opacity: 0.75; font-size: 0.95rem; }
  .kind {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid currentColor;
    opacity: 0.7;
  }
  .kind-llm { color: #7aa2f7; }
  .kind-tool { color: #9ece6a; }
  .kind-gate { color: #e0af68; }
</style>
