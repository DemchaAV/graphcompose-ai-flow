---
import data from '../data/generated/pipeline.json';
import project from '../data/generated/project.json';
import { Spell } from '../lib/numbers';
// Repository paths are written out literally; see the note in Architecture.astro.
const repoUrl = 'https://github.com/DemchaAV/graphcompose-ai-flow';
const stages = data.stages as Array<{
  id: string;
  label: string;
  kind: string;
  description: string;
  tool: string | null;
}>;
const workflows = data.workflows as Array<{
  id: string;
  skill: string;
  summary: string;
  scopes: string[];
}>;

// The count comes from the config, so the heading follows the skills rather
// than restating a number by hand.
const workflowCount = Spell(workflows.length);
---
<section id="pipeline" class="pipeline">
  <div class="container">
    <p class="eyebrow">05 · how it works</p>
    <h2>{workflowCount} skills. One bounded loop.</h2>
    <p class="lede">
      You say what you want; a workflow skill owns the request end to end. Behind it
      the same ordered stages run — some are the model's judgement, most are a CLI,
      and the last two are gates that decide with an exit code, not an opinion.
      <em>This is the moat against prompt-and-hope.</em>
    </p>

    <ul class="workflows">
      {workflows.map((workflow) => (
        <li class="workflow">
          <a href={`${repoUrl}/blob/main/${workflow.skill}`}><code>{workflow.id}</code></a>
          <span>{workflow.summary}</span>
        </li>
      ))}
    </ul>

    <ol class="chain">
      {stages.map((stage, idx) => (
        <li class="step">
          <span class="num">{String(idx + 1).padStart(2, '0')}</span>
          <span class="label">{stage.label}</span>
          <span class={`kind kind-${stage.kind}`}>{stage.kind}</span>
          <span class="role">
            {stage.description}
            {stage.tool && <code class="tool">{stage.tool}</code>}
          </span>
        </li>
      ))}
    </ol>

    <div class="bounds">
      <div class="gates">
        <p class="bounds-label">the gate each scope ends on</p>
        <ul>
          {project.gates.map((gate) => (
            <li>
              <code>{gate.id}</code>
              <span>{gate.summary}</span>
              <em>vs the {gate.comparedAgainst}</em>
            </li>
          ))}
        </ul>
      </div>
      <div class="limits">
        <p class="bounds-label">what ends the loop</p>
        <ul>
          <li><strong>{project.limits.maxIterations}</strong> iterations</li>
          <li><strong>{project.limits.maxConsecutiveBuildFailures}</strong> build failures in a row</li>
          <li><strong>{project.limits.maxSameMismatchAttempts}</strong> attempts at one mismatch</li>
        </ul>
        <p class="bounds-note">
          Reaching a bound with work still open is its own exit code, not a silent stop.
          {project.scopeCount} scopes route through these stages;
          {project.failureCategories.length} failure categories are declared for what can go wrong.
        </p>
      </div>
    </div>

    <p class="footnote">
      Which stages a scope runs, the gate it ends on and the loop bounds are declared once in
      <a href={`${repoUrl}/blob/main/config/pipeline.json`}><code>config/pipeline.json</code></a>,
      which this list is generated from at build time. The skills that run them live in
      <a href={`${repoUrl}/blob/main/skills/workflows`}><code>skills/workflows/</code></a>.</p>
  </div>
</section>

<style>
  .lede {
    max-width: 720px;
    color: var(--fg-muted);
    margin: 16px 0 48px 0;
    font-size: 1.05rem;
  }
  .lede em {
    color: var(--fg);
    font-style: normal;
  }

  /* Ten stages as ten cards ran to two and a half screens for what is reference
     material, not an argument. One row each: the reader scans the chain, and
     config/pipeline.json holds the detail. */
  .chain {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .step {
    display: grid;
    grid-template-columns: 34px 150px 46px 1fr;
    gap: 4px 14px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 720px) {
    .step {
      grid-template-columns: 34px 1fr auto;
    }
    .step .role {
      grid-column: 2 / -1;
    }
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--fg);
  }
  .role {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .tool {
    display: inline-block;
    margin-left: 8px;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-elev);
    color: var(--fg-dim);
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .kind {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 5px;
    border-radius: 3px;
    border: 1px solid currentColor;
    opacity: 0.75;
  }

  .bounds {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 32px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 820px) {
    .bounds {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  .bounds-label {
    margin: 0 0 14px 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .bounds ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .gates li {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 6px 14px;
    align-items: baseline;
    font-size: 0.9rem;
    color: var(--fg-muted);
    line-height: 1.5;
  }
  @media (max-width: 620px) {
    .gates li {
      grid-template-columns: 1fr;
    }
  }
  .gates code {
    color: var(--warn);
    font-size: 0.82rem;
  }
  .gates em {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    white-space: nowrap;
  }
  .limits li {
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .limits strong {
    font-family: var(--font-mono);
    color: var(--accent);
    margin-right: 6px;
  }
  .bounds-note {
    margin: 16px 0 0 0;
    color: var(--fg-dim);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .footnote {
    margin-top: 40px;
    color: var(--fg-dim);
    font-size: 0.9rem;
  }
  .footnote code {
    color: var(--fg-muted);
  }

  .workflows {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    gap: 0.5rem;
  }
  .workflows li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: baseline;
  }
  .workflows code { font-size: 0.9rem; }
  .workflows span { opacity: 0.75; font-size: 0.95rem; }
  .kind-llm { color: #7aa2f7; }
  .kind-tool { color: #9ece6a; }
  .kind-gate { color: #e0af68; }
</style>
