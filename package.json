{
  "name": "graphcompose-ai-flow",
  "version": "0.0.0",
  "private": true,
  "description": "Local workflow kit that turns visual document references into maintainable GraphCompose Java templates.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "preview": "node scripts/preview-live.mjs",
    "preview:debug": "node scripts/preview-live.mjs --debug",
    "test": "node --test \"scripts/test/**/*.test.mjs\"",
    "validate:schemas": "node .github/scripts/validate-schemas.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
