{
  "name": "graphcompose-ai-flow",
  "version": "0.23.0",
  "private": true,
  "description": "Installable GraphCompose harness for coding agents: drop in a document reference, get a maintainable Java template, rendered, compared and iterated until ready for approval.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "preview": "node scripts/preview-live.mjs",
    "preview:debug": "node scripts/preview-live.mjs --debug",
    "test": "node scripts/run-tests.mjs scripts/test",
    "validate:schemas": "node .github/scripts/validate-schemas.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick"
  },
  "engines": {
    "node": ">=20"
  }
}
