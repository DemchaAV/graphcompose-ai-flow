# Java / Kotlin build output
target/
build/
out/
*.class

# Maven
.mvn/
dependency-reduced-pom.xml

# Gradle
.gradle/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
build.log
render.log

# Node (reserved for future tools/)
node_modules/
*.log.*
npm-debug.log*

# Private working notes (convention: gitignored)
docs/private/

# Local environment
.env
.env.local

# Top-level temp render artifacts only.
# Do NOT blanket-ignore *.pdf or *.png — revision artifacts under examples/
# are committed on purpose and must remain tracked.
/output.pdf
/output.png

# Shell interpolation accidents — files named after unexpanded variables or
# stray shell punctuation. They come from PowerShell heredocs / pipelines that
# write to ${command}, ${file}, etc. when the variable was empty. Never
# legitimate content.
/${*}
/${command}
/0
/0\)

# Local skill-validation-cache contents. The tool itself is tracked;
# the cached verdict JSONs under .cache/ are per-machine and rebuilt
# on demand.
tools/skill-validation-cache/.cache/

