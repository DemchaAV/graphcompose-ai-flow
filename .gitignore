# Java / Kotlin build output
target/
build/
out/
*.class

# Maven
.mvn/
dependency-reduced-pom.xml

# Gradle
.gradle/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
build.log
render.log

# Node (reserved for future tools/)
node_modules/
*.log.*
npm-debug.log*

# Private working notes (convention: gitignored)
docs/private/

# Local environment
.env
.env.local

# Top-level temp render artifacts only.
# Do NOT blanket-ignore *.pdf or *.png — revision artifacts under examples/
# are committed on purpose and must remain tracked.
/output.pdf
/output.png

# Live-preview mirror — a stable copy of the most recent render, regenerated on
# every render so a watching viewer (SumatraPDF) reloads in place. Derived and
# per-machine; never committed. Location is overridable via GRAPHCOMPOSE_LIVE_DIR.
/live/

# Shell interpolation accidents — files named after unexpanded variables or
# stray shell punctuation. They come from PowerShell heredocs / pipelines that
# write to ${command}, ${file}, etc. when the variable was empty. Never
# legitimate content.
/${*}
/${command}
/0
/0\)
/*)

# CLI-output / code-snippet accidents — a revision-manager subcommand name
# (e.g. `approve`) or a Java code fragment (`renderMain(...`) captured as a
# filename by a stray redirect. Anchored to root; no real root file has a
# paren in its name.
/Approve
/render*(*

# Local skill-validation-cache contents. The tool itself is tracked;
# the cached verdict JSONs under .cache/ are per-machine and rebuilt
# on demand.
tools/skill-validation-cache/.cache/

# Local asset-resolver icon cache. PNGs downloaded from iconify are
# byte-identical across machines for the same (prefix, name, size,
# color) tuple, so caching them locally just avoids the HTTP roundtrip;
# CI rebuilds the cache on demand.
tools/asset-resolver/.cache/

# Dev container feature lockfile — regenerated by `devcontainer up` from the
# pinned feature versions. Left to float to latest features for this early
# project; remove this line and commit the lock if you want reproducible pins.
.devcontainer/devcontainer-lock.json

