{
  "name": "graphcompose-ai-flow",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y imagemagick librsvg2-bin fontconfig fonts-dejavu-core && sudo rm -rf /var/lib/apt/lists/*",
  "postCreateCommand": "npm run setup",
  "containerEnv": {
    "MAGICK_BINARY": "convert"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  }
}
