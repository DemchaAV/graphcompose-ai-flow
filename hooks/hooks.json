{
  "$schema": "https://code.claude.com/schemas/hooks.json",
  "description": "Two kinds of hook. The telemetry checkpoints (SessionStart, UserPromptSubmit, Stop, SubagentStop, SessionEnd) only record timestamps and the transcript location; they call no model, decide nothing, and always exit 0 so a measurement can never block the work it measures. The PreToolUse guards refuse shortcuts the workflow skills forbid: on Bash, reading a template or the layout snapshot through the shell, a raw `magick compare`, patching Java with an inline script; on Write, replacing a canonical discovery artifact in place instead of through scripts/write-artifact.mjs, which stages, validates and renames so a concurrent reader never sees half a file. Each names the harness command to run instead; GRAPHCOMPOSE_GUARD=off bypasses them.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard-bash.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard-artifact-write.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry/claude-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry/claude-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry/claude-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry/claude-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry/claude-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
