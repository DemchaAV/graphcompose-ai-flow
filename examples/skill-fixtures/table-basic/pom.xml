<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.demcha.graphcompose-ai-flow.fixtures</groupId>
  <artifactId>skill-fixture-table-basic</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <graphcompose.version>1.9.0</graphcompose.version>
  </properties>

  <!--
    GraphCompose 1.6.6+ ships through Maven Central as
    io.github.demchaav:graph-compose. No <repositories> block needed —
    Central is Maven's default. Older callers pinned to v1.6.5 and
    earlier can still resolve com.github.DemchaAV:GraphCompose:vX.Y.Z
    via JitPack (https://jitpack.io) as a fallback.
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.demchaav</groupId>
      <artifactId>graph-compose</artifactId>
      <version>${graphcompose.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
